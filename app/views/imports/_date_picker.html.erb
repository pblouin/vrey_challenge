<% first_day = (calendar_month || date).beginning_of_month %>
<% last_day = first_day.end_of_month %>
<% dates = { start_date: @start_date, end_date: @end_date } %>

<details class="relative" <%= "open" if calendar_month %>>
  <summary class="pill cursor-pointer list-none gap-2 font-medium">
    <%= lucide_icon "calendar", class: "size-4 text-brand" %>
    <%= l date, format: "%-d %B %Y" %>
  </summary>

  <div class="card absolute z-10 mt-2 w-72 p-4">
    <div class="mb-3 flex items-center justify-between">
      <%= link_to lucide_icon("chevron-left", class: "size-4"), new_import_path(dates.merge("#{name}_calendar" => first_day.prev_month)), data: { turbo_action: "replace" } %>
      <span class="font-medium"><%= l first_day, format: "%B %Y" %></span>
      <%= link_to lucide_icon("chevron-right", class: "size-4"), new_import_path(dates.merge("#{name}_calendar" => first_day.next_month)), data: { turbo_action: "replace" } %>
    </div>

    <div class="grid grid-cols-7 gap-1 text-center text-sm">
      <% %w[Mo Tu We Th Fr Sa Su].each do |weekday| %>
        <span class="text-xs text-muted"><%= weekday %></span>
      <% end %>

      <% first_day.cwday.pred.times do %>
        <span></span>
      <% end %>

      <% (first_day..last_day).each do |day| %>
        <% if day > Date.today %>
          <span class="rounded-full py-1 text-line"><%= day.day %></span>
        <% else %>
          <%= link_to day.day, new_import_path(dates.merge(name => day)),
                class: day == date ? "rounded-full bg-brand py-1 text-white hover:text-white" : "rounded-full py-1 text-ink hover:bg-brand-light",
                data: { turbo_action: "replace" } %>
        <% end %>
      <% end %>
    </div>
  </div>
</details>
